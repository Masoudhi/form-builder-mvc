@model LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Sign in";
    var demoNotice = Config["Demo:Notice"];   // set on the public demo, e.g. "Demo data is reset every night (03:00 UTC)."
}

<div class="login-wrap">
    <div class="login-card card">
        <div class="text-center mb-4">
            <span class="logo logo-lg" aria-hidden="true">▤</span>
            <h1 class="h4 mt-3 mb-1">Sign in to Form Builder</h1>
            <p class="text-muted mb-0">Design forms and collect validated answers.</p>
        </div>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Sign in</button>
        </form>

        <div class="demo-accounts">
            <p class="mb-1 fw-semibold">Demo accounts</p>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr><td><code>admin</code> / <code>Admin@@12345</code></td><td>Level 100 · designs forms</td></tr>
                    <tr><td><code>user</code> / <code>User@@12345</code></td><td>Level 10 · fills in forms</td></tr>
                </tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(demoNotice))
            {
                <p class="text-muted small mt-2 mb-0">@demoNotice</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
