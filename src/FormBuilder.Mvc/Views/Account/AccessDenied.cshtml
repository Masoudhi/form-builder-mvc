@{
    ViewData["Title"] = "Access denied";
}

<div class="card empty-state">
    <div class="empty-icon" aria-hidden="true">🔒</div>
    <h1 class="h4">You don't have access to this page</h1>
    <p class="text-muted">Designing forms and viewing submissions needs a level 100 account.<br />
        You are signed in as <strong>@User.Identity?.Name</strong> (level @User.Level()).</p>
    <a class="btn btn-primary" asp-controller="Forms" asp-action="Index">Back to my forms</a>
</div>
